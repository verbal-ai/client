[Unit]
Description=Turnkey Wifi Manager for hotspot
After=network.target wpa_supplicant.service dhcpcd.service wifi_connector.service
Wants=wpa_supplicant.service dhcpcd.service

[Service]
Type=simple
Environment=VIRTUAL_ENV=/home/dev/client/venv
Environment=PATH=/home/dev/client/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
ExecStart=/bin/bash -c 'source /home/dev/client/venv/bin/activate && python3 /home/dev/client/src/firmware/turnkey/main.py'
WorkingDirectory=/home/dev/client/src/firmware/
StandardOutput=inherit
StandardError=inherit
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target