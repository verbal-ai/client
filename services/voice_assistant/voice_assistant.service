[Unit]
Description=Voice Assistant Service
After=network.target

[Service]
Type=simple
Environment=VIRTUAL_ENV=/home/dev/client/venv
Environment=PATH=/home/dev/client/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
Environment=PERSONALIZATION_FILE=/home/dev/client/personalization.json
Environment=VOSK_MODEL_PATH=/home/dev/client/data/vosk-model-small-en-us-0.15
ExecStart=/bin/bash -c 'source /home/dev/client/venv/bin/activate; python3 /home/dev/client/src/main.py'
WorkingDirectory=/home/dev/client/src/
StandardOutput=inherit
StandardError=inherit
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
